<Window x:Class="TNovMEPSpec.MEPSpecOVVKParamsWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovMEPSpec"
        mc:Ignorable="d"
        Width="460"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:MEPSpecOVVKParamsViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown" Background="Transparent" Cursor="Arrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СВОДНАЯ СПЕКА"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Text="Настройки заполнения параметров"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,2,0,6"/>
            <TextBlock Text="{Binding elemType}"
                       Style="{StaticResource CardTitleStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <Border Style="{StaticResource PanelFrameStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Настройки заполнения Наименования"
                               Style="{StaticResource PanelHeaderStyle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Параметр 1 (по типу)"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding naimPar1}"
                                 Style="{StaticResource DarkCompactTextBoxStyle}" Height="36"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Параметр 2"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding naimPrefix2}"
                                 Style="{StaticResource DarkCompactTextBoxStyle}"/>
                        <ComboBox Grid.Column="3"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding paramlist}"
                                  SelectedItem="{Binding Path=naimPar2, Mode=TwoWay}"
                                  SelectedIndex="0"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Параметр 3"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding naimPrefix3}"
                                 Style="{StaticResource DarkCompactTextBoxStyle}"/>
                        <ComboBox Grid.Column="3"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding paramlist}"
                                  SelectedItem="{Binding Path=naimPar3, Mode=TwoWay}"
                                  SelectedIndex="0"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Параметр 4"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding naimPrefix4}"
                                 Style="{StaticResource DarkCompactTextBoxStyle}"/>
                        <ComboBox Grid.Column="3"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding paramlist}"
                                  SelectedItem="{Binding Path=naimPar4, Mode=TwoWay}"
                                  SelectedIndex="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelFrameStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Настройки заполнения Количества"
                               Style="{StaticResource PanelHeaderStyle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Исходный параметр"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding paramlist2}"
                                  SelectedItem="{Binding Path=countPar, Mode=TwoWay}"
                                  SelectedIndex="0"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Коэффициент"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding countK}"
                                 Style="{StaticResource DarkTextBoxStyle}" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="Применить"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="acceptButton"
                    IsDefault="True"
                    Click="acceptButton_Click"/>
            <Button Content="Отмена"
                    Style="{StaticResource CloseButtonStyle}"
                    x:Name="escButton"
                    IsCancel="True"
                    Click="escButton_Click"/>
        </StackPanel>
    </Border>
</Window>
