<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{C89D852B-B461-4ACF-86CA-2D8A65D55D56}</ProjectGuid>
    <RootNamespace>TNovMEPSpec</RootNamespace>
    <AssemblyName>TNovMEPSpec</AssemblyName>
  </PropertyGroup>

  <!-- Файл не входил в исходный проект (устаревший дубликат из TNovVent). -->
  <ItemGroup>
    <Compile Remove="DuctThicknessClasses.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
