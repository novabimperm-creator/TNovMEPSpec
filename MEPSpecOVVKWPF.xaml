<Window x:Class="TNovMEPSpec.MEPSpecOVVKWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovMEPSpec"
        mc:Ignorable="d"
        Width="732"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:MEPSpecOVVKViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СВОДНАЯ СПЕКА"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource PanelFrameStyle}"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Выбор категорий, настройки заполнения ADSK параметров"
                               Style="{StaticResource PanelHeaderStyle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="207"/>
                            <ColumnDefinition Width="207"/>
                            <ColumnDefinition Width="207"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Категория"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Группирование"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="Наименование и Количество"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <ScrollViewer Name="scroll"
                                  CanContentScroll="False"
                                  MaxHeight="310"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Name="sp01" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run1}">
                                    <TextBlock Text="Арматура воздуховодов"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output1, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                            </Grid>

                            <Grid Name="sp02" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run2}">
                                    <TextBlock Text="Воздухораспределители"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output2, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                            </Grid>

                            <Grid Name="sp03" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run3}">
                                    <TextBlock Text="Гибкие воздуховоды"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output3, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                                <StackPanel Grid.Column="2" Name="sp3" Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Name="sp04" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run4}">
                                    <TextBlock Text="Внутр. изоляция возд."
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output4, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                                <StackPanel Grid.Column="2" Name="sp4" Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Name="sp05" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run5}">
                                    <TextBlock Text="Воздуховоды"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output5, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                                <StackPanel Grid.Column="2" Name="sp5" Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Name="sp06" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run6}">
                                    <TextBlock Text="Изоляция воздуховодов"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output6, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                                <StackPanel Grid.Column="2" Name="sp6" Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Name="sp07" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run7}">
                                    <TextBlock Text="Фитинги воздуховодов"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output7, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                                <StackPanel Grid.Column="2" Name="sp7" Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Name="sp08" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run8}">
                                    <TextBlock Text="Оборудование"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <TextBlock Grid.Column="1"
                                           Text="Имя системы"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Name="sp09" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run9}">
                                    <TextBlock Text="Арматура труб"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output9, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                            </Grid>

                            <Grid Name="sp010" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run10}">
                                    <TextBlock Text="Гибкие трубы"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output10, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                                <StackPanel Grid.Column="2" Name="sp10" Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Name="sp011" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run11}">
                                    <TextBlock Text="Трубы"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output11, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                                <StackPanel Grid.Column="2" Name="sp11" Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Name="sp012" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run12}">
                                    <TextBlock Text="Изоляция труб"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output12, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                                <StackPanel Grid.Column="2" Name="sp12" Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Name="sp013" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run13}">
                                    <TextBlock Text="Фитинги труб"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output13, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                            </Grid>

                            <Grid Name="sp014" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                    <ColumnDefinition Width="207"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              Padding="10,8"
                                              IsChecked="{Binding run14}">
                                    <TextBlock Text="Сантехника"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ComboBox Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding paramlist}"
                                          SelectedItem="{Binding Path=output14, Mode=TwoWay}"
                                          SelectedIndex="0"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource PanelFrameStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Общие настройки" Style="{StaticResource PanelHeaderStyle}"/>
                    <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Name="adskgbox"
                                              Grid.Column="0"
                                              Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              IsChecked="{Binding runadskg}">
                                    <StackPanel>
                                        <TextBlock Text="Заполнить ADSK Группирование"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Для сортировки спецификации по системам"
                                                   Style="{StaticResource CardSubtitleStyle}"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              IsChecked="{Binding systemcut}">
                                    <StackPanel>
                                        <TextBlock Text="Отбрасывать лишние системы"
                                                   Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Из исходника оставить только первую"
                                                   Style="{StaticResource CardSubtitleStyle}"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                              Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              IsChecked="{Binding runadskp}">
                                    <TextBlock Text="Заполнить ADSK Наименование и ADSK Количество"
                                               Style="{StaticResource CardTitleStyle}"
                                               TextWrapping="Wrap"/>
                                </ToggleButton>
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              IsChecked="{Binding runNCat}">
                                    <StackPanel>
                                        <TextBlock Text="Заполнить N Категория"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Для сортировки по категориям (оборудование сверху)"
                                                   Style="{StaticResource CardSubtitleStyle}"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                              Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              IsChecked="{Binding runCatalogs}">
                                    <StackPanel>
                                        <TextBlock Text="Обрабатывать каталоги"
                                                   Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Style="{StaticResource CardSubtitleStyle}">
                                            <Hyperlink NavigateUri="https://portal.talan.group/knowledge/proektirovanie/MEPspec/"
                                                       RequestNavigate="Hyperlink_RequestNavigate"
                                                       Style="{StaticResource MutedHyperlinkStyle}">
                                                справка
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource CardToggleStyle}"
                                              Margin="0"
                                              IsChecked="{Binding runNonModel}">
                                    <StackPanel>
                                        <TextBlock Text="Построить немоделируемые элементы"
                                                   Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Style="{StaticResource CardSubtitleStyle}">
                                            <Hyperlink NavigateUri="https://portal.talan.group/knowledge/proektirovanie/MEPspec/"
                                                       RequestNavigate="Hyperlink_RequestNavigate"
                                                       Style="{StaticResource MutedHyperlinkStyle}">
                                                справка
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Отмена"
                        x:Name="escButton"
                        Style="{StaticResource CloseButtonStyle}"
                        IsCancel="True"
                        Click="escButton_Click"/>
                <Button Grid.Column="2"
                        Content="Запуск для выбранных"
                        Style="{StaticResource RunButtonStyle}" Margin="0"
                        Command="{Binding Path=scenario2}"
                        Click="acceptButton_Click"/>
                <Button Grid.Column="4"
                        Content="Запуск для всех"
                        Style="{StaticResource RunButtonStyle}" Margin="0"
                        IsDefault="True"
                        Command="{Binding Path=scenario1}"
                        Click="acceptButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
