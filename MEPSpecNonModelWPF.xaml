<Window x:Class="TNovMEPSpec.MEPSpecNonModelWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovMEPSpec"
        mc:Ignorable="d"
        Width="1200"
        Height="620"
        MinWidth="700"
        MinHeight="320"
        d:DataContext="{d:DesignInstance local:MEPSpecNonModelViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- заголовок столбца со строкой поиска -->
            <Style x:Key="NonModelHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkDataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
            </Style>
            <Style x:Key="NonModelFilterStyle" TargetType="TextBox" BasedOn="{StaticResource DarkCompactTextBoxStyle}">
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="ToolTip" Value="Поиск по столбцу"/>
            </Style>
            <Style x:Key="NonModelEditStyle" TargetType="TextBox" BasedOn="{StaticResource DarkCompactTextBoxStyle}"/>
            <Style x:Key="NonModelCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent" Cursor="Arrow" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="НЕМОДЕЛИРУЕМЫЕ"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="closeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="Элементы «pmN.Условное семейство Экземпляр» создаются правилами и перезаполняются при запуске Сводной спеки. Элементы «pmN.Условное семейство (ОбМод)» — ручные, генерация их не меняет."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,12"/>

            <DataGrid Grid.Row="2"
                      x:Name="grid"
                      ItemsSource="{Binding View}"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource NonModelHeaderStyle}"
                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      RowHeaderWidth="0"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="1.2*"
                                        Binding="{Binding ADSK_Группирование, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource NonModelCellTextStyle}" EditingElementStyle="{StaticResource NonModelEditStyle}">
                        <DataGridTextColumn.Header>
                            <StackPanel>
                                <TextBlock Text="ADSK_Группирование" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource NonModelFilterStyle}" Text="{Binding DataContext.FilterGroup, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="2.5*"
                                        Binding="{Binding ADSK_Наименование, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource NonModelCellTextStyle}" EditingElementStyle="{StaticResource NonModelEditStyle}">
                        <DataGridTextColumn.Header>
                            <StackPanel>
                                <TextBlock Text="ADSK_Наименование" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource NonModelFilterStyle}" Text="{Binding DataContext.FilterNaim, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding ADSK_Марка, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource NonModelCellTextStyle}" EditingElementStyle="{StaticResource NonModelEditStyle}">
                        <DataGridTextColumn.Header>
                            <StackPanel>
                                <TextBlock Text="ADSK_Марка" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource NonModelFilterStyle}" Text="{Binding DataContext.FilterMark, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding ADSK_КодИзделия, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource NonModelCellTextStyle}" EditingElementStyle="{StaticResource NonModelEditStyle}">
                        <DataGridTextColumn.Header>
                            <StackPanel>
                                <TextBlock Text="ADSK_Код изделия" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource NonModelFilterStyle}" Text="{Binding DataContext.FilterCode, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding ADSK_ЗаводИзготовитель, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource NonModelCellTextStyle}" EditingElementStyle="{StaticResource NonModelEditStyle}">
                        <DataGridTextColumn.Header>
                            <StackPanel>
                                <TextBlock Text="ADSK_Завод-изготовитель" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource NonModelFilterStyle}" Text="{Binding DataContext.FilterManufacturer, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="0.8*"
                                        Binding="{Binding ADSK_ЕдиницаИзмерения, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource NonModelCellTextStyle}" EditingElementStyle="{StaticResource NonModelEditStyle}">
                        <DataGridTextColumn.Header>
                            <StackPanel>
                                <TextBlock Text="ADSK_Единица измерения" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource NonModelFilterStyle}" Text="{Binding DataContext.FilterUnit, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="0.8*"
                                        Binding="{Binding ADSK_Количество, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource NonModelCellTextStyle}" EditingElementStyle="{StaticResource NonModelEditStyle}">
                        <DataGridTextColumn.Header>
                            <StackPanel>
                                <TextBlock Text="ADSK_Количество" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource NonModelFilterStyle}" Text="{Binding DataContext.FilterQuantity, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="1.2*" IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <StackPanel>
                                <TextBlock Text="Источник" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource NonModelFilterStyle}" Text="{Binding DataContext.FilterSource, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource MutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GeneratedByRule}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GeneratedByRule}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Hyperlink Click="Rule_Click"
                                                   Style="{StaticResource MutedHyperlinkStyle}"
                                                   Tag="{Binding RuleDescription}">
                                            <Run Text="{Binding SourceText, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3"
                       Text="{Binding Status}"
                       TextWrapping="Wrap"
                       Foreground="#E05A5A"
                       FontSize="12"
                       Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Закрыть"
                        Style="{StaticResource CloseButtonStyle}"
                        IsCancel="True"
                        Click="closeButton_Click"/>
                <Button Grid.Column="2"
                        Content="Добавить из каталога"
                        Style="{StaticResource RunButtonStyle}" Margin="0"
                        Click="catalogButton_Click"/>
                <Button Grid.Column="4"
                        Content="Сохранить изменения"
                        Style="{StaticResource RunButtonStyle}" Margin="0"
                        Click="saveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
