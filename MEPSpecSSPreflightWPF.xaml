<Window x:Class="TNovMEPSpec.MEPSpecSSPreflightWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovMEPSpec"
        mc:Ignorable="d"
        Width="980"
        Height="560"
        d:DataContext="{d:DesignInstance local:MEPSpecSSPreflightViewModel}"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MinWidth="720"
        MinHeight="360"
        ShowInTaskbar="True"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PreflightGridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="PreflightGridCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PreflightSelectButtonStyle" TargetType="Button" BasedOn="{StaticResource RunButtonStyle}">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TitleText}"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Command="{Binding CloseCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{Binding HeaderText}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,12"/>

            <Border Grid.Row="2"
                    Style="{StaticResource PanelFrameStyle}"
                    Margin="0,0,0,12"
                    Padding="0">
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternationCount="2"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="Transparent"
                          BorderThickness="0"
                          HorizontalGridLinesBrush="{StaticResource CardBrush}"
                          VerticalGridLinesBrush="Transparent"
                          ColumnHeaderStyle="{StaticResource PreflightGridHeaderStyle}"
                          CellStyle="{StaticResource PreflightGridCellStyle}"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{StaticResource CardBrush}"
                          Foreground="{StaticResource MutedBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Группирование"
                                            Binding="{Binding Grouping}"
                                            Width="1.2*"/>
                        <DataGridTextColumn Header="Категория"
                                            Binding="{Binding Category}"
                                            Width="0.8*"/>
                        <DataGridTextColumn Header="Проблемные параметры"
                                            Binding="{Binding ProblemParams}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Кол-во"
                                            Binding="{Binding Count}"
                                            Width="70"/>
                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding ElementIdsText}"
                                            Width="1.2*"/>
                        <DataGridTemplateColumn Header="" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Выделить"
                                            Style="{StaticResource PreflightSelectButtonStyle}"
                                            Command="{Binding SelectCommand}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Button Grid.Row="3"
                    Content="Закрыть"
                    Style="{StaticResource CloseButtonStyle}"
                    Command="{Binding CloseCommand}"
                    IsCancel="True"
                    IsDefault="True"/>
        </Grid>
    </Border>
</Window>
