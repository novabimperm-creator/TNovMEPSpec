<Window x:Class="TNovMEPSpec.MEPSpecSSTypePreviewWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovMEPSpec"
        mc:Ignorable="d"
        Width="1100"
        Height="720"
        d:DataContext="{d:DesignInstance local:MEPSpecSSTypePreviewViewModel}"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MinWidth="800"
        MinHeight="420"
        ShowInTaskbar="True"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TypePreviewGridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="TypePreviewGridCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TypePreviewSelectButtonStyle" TargetType="Button" BasedOn="{StaticResource RunButtonStyle}">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="MinWidth" Value="160"/>
            </Style>
            <DataTemplate x:Key="TypePreviewRowTemplate">
                <Border Style="{StaticResource PanelFrameStyle}"
                        Margin="0,0,0,12"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1"
                                    Content="Выделить в модели"
                                    Style="{StaticResource TypePreviewSelectButtonStyle}"
                                    Command="{Binding SelectCommand}"/>
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Parameters}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternationCount="2"
                                  RowHeaderWidth="0"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MaxHeight="200"
                                  EnableRowVirtualization="True"
                                  HorizontalGridLinesBrush="{StaticResource CardBrush}"
                                  VerticalGridLinesBrush="Transparent"
                                  ColumnHeaderStyle="{StaticResource TypePreviewGridHeaderStyle}"
                                  CellStyle="{StaticResource TypePreviewGridCellStyle}"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{StaticResource CardBrush}"
                                  Foreground="{StaticResource MutedBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Параметр"
                                                    Binding="{Binding Name}"
                                                    Width="220"/>
                                <DataGridTextColumn Header="Значение"
                                                    Binding="{Binding Value}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ТИПЫ КОРОБОВ И ЛОТКОВ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Command="{Binding CancelCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{Binding HeaderText}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,12"/>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Короба (ConduitTypes)"
                               Style="{StaticResource PanelHeaderStyle}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Типы коробов не найдены."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConduitRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ConduitRows}"
                                  ItemTemplate="{StaticResource TypePreviewRowTemplate}"/>
                    <TextBlock Text="Лотки (CableTrayTypes)"
                               Style="{StaticResource PanelHeaderStyle}"
                               Margin="0,8,0,8"/>
                    <TextBlock Text="Типы лотков не найдены."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CableTrayRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding CableTrayRows}"
                                  ItemTemplate="{StaticResource TypePreviewRowTemplate}"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Content="Отмена"
                        Style="{StaticResource CloseButtonStyle}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        MinWidth="120"
                        Height="38"
                        Margin="0"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="3"
                        Content="Далее"
                        Style="{StaticResource RunButtonStyle}"
                        Command="{Binding ContinueCommand}"
                        IsDefault="True"
                        MinWidth="120"
                        Height="38"
                        Margin="0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
